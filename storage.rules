rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Allow unauthenticated uploads to properties folder for scraping
    match /properties/{allPaths=**} {
      allow write: if true; // Allow unauthenticated uploads for scraping
    }
    
    // Require authentication for all other uploads
    match /{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
