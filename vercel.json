{
  "version": 2,
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_ENV": "production",
    "STORAGE_TYPE": "database",
    "UPLOAD_PROVIDER": "external",
    "ENABLE_BULK_DELETE": "true",
    "ENABLE_EXPORT": "true",
    "ENABLE_AI_FEATURES": "true",
    "MAX_PROPERTIES": "10000",
    "MAX_UPLOAD_SIZE": "10485760",
    "MAX_IMAGES_PER_PROPERTY": "15",
    "MAX_DATA_URL_IMAGES": "8",
    "MAX_COMPRESSED_IMAGE_SIZE": "60000",
    "MAX_DOCUMENT_SIZE": "900000"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
